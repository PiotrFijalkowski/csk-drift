{
  "name": "csk-drift",
  "version": "1.0.0",
  "description": "WordPress theme for csk-drift",
  "main": "index.js",
  "scripts": {
    "build:css": "sass src/scss/main.scss dist/css/main.css --style compressed --no-source-map",
    "copy:img": "copyfiles -u 2 src/img/**/* dist/img",
    "watch:css": "sass --watch src/scss/main.scss dist/css/main.css",
    "watch:img": "onchange \"src/img/**/*\" -- npm run copy:img",
    "watch:php": "onchange \"**/*.php\" -- echo \"PHP file changed\"",
    "watch": "npm-run-all --parallel watch:*",
    "dev": "npm run watch",
    "build": "npm run build:css && npm run copy:img"
  },
  "keywords": [],
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "sass": "^1.69.0"
  }
}